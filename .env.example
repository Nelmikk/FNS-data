# ip для запуска без докера (127.0.0.1), название контейнера для докера (fns-pg-database)
DB_host = 'fns-pg-database'
DB_port = 5432
DB_name = 'postgres'

DB_super_user_name = 'postgres'
DB_super_user_password = 'SUPER_USER_PASSWORD'

DB_select_user_name = 'select_user'
DB_select_user_password = 'SELECT_USER_PASSWORD'

# ВАЖНО (FNS_cpu_count * FNS_semaphore_count) + (API_workers * (API_Engine_pool_size + API_Engine_max_overflow)) < max_connections в postgres.
FNS_cpu_count = 1
FNS_semaphore_count = 2

API_app = 'api:app'
API_host = '0.0.0.0'
API_host_port = 8000
API_port = 8000
API_reload = True
API_workers = 4

API_Engine_pool_size = 4
API_Engine_max_overflow = 4